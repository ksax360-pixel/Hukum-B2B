# Hukum Environment

# App — production must be https://www.hukum.sa
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NOINDEX=1
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/kingdom-trade

# Auth (generate a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
AUTH_TOKEN_TTL=7d

# Main Admin Panel (admin-panel on :3001) CORS — comma-separated allowlist in production
ADMIN_CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Demo account auto-provision on login (MUST be false/unset in production)
ENABLE_DEMO_ACCOUNTS=false

# AI (OpenAI-compatible). Leave empty to disable AI endpoints gracefully.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.8

# SMS / OTP (optional)
SMS_PROVIDER=
SMS_API_KEY=

# Payments (optional)
# demo = activate Gold/Premium without card (dev). none = hard-disable. moyasar|stripe later.
PAYMENT_PROVIDER=demo
PAYMENT_API_KEY=

# Storage (local uploads by default)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
NEXT_PUBLIC_SELLER_ADMIN_URL=http://localhost:3002

# Image generation (DALL·E)
AI_IMAGE_MODEL=gpt-image-1.5
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_COUNT=3
